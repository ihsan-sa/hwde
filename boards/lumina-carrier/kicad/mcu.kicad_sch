	(text "GPIO45 (U30 pad 26) IS A NO-CONNECT BY DESIGN: pulled high at power-up on this no-PSRAM -N8 it selects 1.8 V VDD_SPI and the 3.3 V flash never boots"
		(exclude_from_sim no)
		(at 139.7 247.65 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "89935aae-9fe6-49f5-a509-c6f4c27fbf3c")
	)
	(text "BOOT idles HIGH through R101 (GPIO0 = 1 -> SPI Boot); SW1 and J2 pin 6 can only pull it low"

(version 1)
# Generated by ai-ee rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1016mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1016mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.2000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.4500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_12V"
	(constraint track_width (min 0.3750mm))
	(condition "A.NetName == '+12V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3"
	(constraint track_width (min 0.0100mm))
	(condition "A.NetName == '+3V3' && A.Type == 'track'")
)
(rule "aiee_pwr_width_48V_SW"
	(constraint track_width (min 0.1250mm))
	(condition "A.NetName == '+48V_SW' && A.Type == 'track'")
)
(rule "aiee_pwr_width_LED0_A"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '/LED0_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_LED1_A"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '/LED1_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_LED2_A"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '/LED2_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_LED3_A"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '/LED3_A' && A.Type == 'track'")
)
(rule "aiee_hv_57v_48V_SW"
	# P5 HAND EDIT - ICD-01 s5 TRAP-1 / stackup.md s7 rule 1. rules_gen emits
	# 0.6000 mm, the IPC-2221B B2 51-100 V FLOOR, NOT this system's binding
	# figure of 0.635 mm (0.025 in, TPS2378 layout section), board-wide, F.Cu
	# and B.Cu, +48V_SW to everything. check_creepage.py only ever demands
	# 0.60, so a 0.635 layout passes it BY CONSTRUCTION - the extra 0.035 mm
	# is enforced ONLY here. Do not restore 0.6000 because P8 goes green.
	#
	# THIS EDIT HAS ALREADY BEEN LOST ONCE: rules_gen OVERWRITES this whole
	# file, and it was reverted by the P5 re-run after the J3/J4 pin swap.
	# RE-APPLY IT AFTER EVERY rules_gen INVOCATION and re-check with:
	#   grep -A1 aiee_hv_57v <board>.kicad_dru
	(constraint clearance (min 0.6350mm))
	(condition "A.NetName == '+48V_SW'")
)
(rule "aiee_hv_57v_V48_B"
	# P6 HAND EDIT - the SECOND 57 V net, found by the placement agent.
	# /power/V48_B is the branch-B front-end node (Q101 drain -> C106/C107/
	# C108). It carries the same 57 V as +48V_SW whenever branch B is
	# populated, and ICD-01 s5 requires 0.635 mm around EVERY 48 V net - but
	# it was never listed in constraints.voltages, so it inherited only the
	# 0.1016 mm global floor: SIX TIMES too tight. Its parts are DNP on
	# branch A, and a DNP part still has pads, so P7 would have routed it at
	# the floor and the clearance would have been wrong in copper forever.
	# Now also declared in constraints.json voltages so check_creepage sees
	# it at P8. Same rules_gen overwrite hazard as the rule above.
	# The exclusion is deliberate and is NOT a fudge to clear a violation.
	# ICD-01 s5 cites TPS2378: "0.025 in between VSS and high-voltage signals
	# such as VDD" - the rule governs the 48 V domain against OTHER domains,
	# not spacing WITHIN it. /power/Q101_G is the hot-swap FET's own gate, in
	# the same domain as its drain, and C108 (the Cgd dV/dt network) bridges
	# them across a single 0805 land whose intrinsic pad gap is 0.590 mm.
	# Without this exclusion the rule fails on the FOOTPRINT's own geometry,
	# which no placement can fix.
	# STILL WORTH A HUMAN LOOK (flagged, not buried): 0.590 mm is also under
	# the IPC-2221B B2 31-50 V floor of 0.60 mm, and during branch-B turn-on
	# the drain swings while the gate is held, so the pair does see tens of
	# volts transiently. Branch A never energises V48_B (Q101 is DNP), so the
	# BUILT board is unaffected - this is a branch-B populate-option review
	# item, recorded in state.json.
	(constraint clearance (min 0.6350mm))
	(condition "A.NetName == '/power/V48_B' && B.NetName != '/power/Q101_G'")
)

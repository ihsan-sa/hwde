	(pad 2 smd oval (at -1.20 0.225 0.00) (size 0.250 0.250) (layers F.Cu F.Paste F.Mask) (solder_mask_margin -0.01) (solder_paste_margin -0.01))
	(pad 1 smd oval (at -1.20 -0.225 0.00) (size 0.250 0.250) (layers F.Cu F.Paste F.Mask) (solder_mask_margin -0.01) (solder_paste_margin -0.01))
	(pad 6 smd oval (at 1.20 0.225 0.00) (size 0.250 0.250) (layers F.Cu F.Paste F.Mask) (solder_mask_margin -0.01) (solder_paste_margin -0.01))

(version 1)
# Generated by ai-ee rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1016mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1016mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.2000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.4500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_40V"
	(constraint track_width (min 5.5000mm))
	(condition "A.NetName == '+40V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_5V"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '+5V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_5V_DRV"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '+5V_DRV' && A.Type == 'track'")
)
(rule "aiee_pwr_width_SW"
	(constraint track_width (min 11.8942mm))
	(condition "A.NetName == '/SW' && A.Type == 'track'")
)
(rule "aiee_pwr_width_tank_TANK_A"
	(constraint track_width (min 8.4123mm))
	(condition "A.NetName == '/tank/TANK_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_tank_TANK_B"
	(constraint track_width (min 8.4123mm))
	(condition "A.NetName == '/tank/TANK_B' && A.Type == 'track'")
)
(rule "aiee_pwr_width_tank_RFOUT"
	(constraint track_width (min 8.4123mm))
	(condition "A.NetName == '/tank/RFOUT' && A.Type == 'track'")
)
(rule "aiee_hv_50v_tank_TANK_B"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/tank/TANK_B'")
)
(rule "aiee_hv_51v_40V"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '+40V'")
)
(rule "aiee_hv_143v_SW"
	(constraint clearance (min 0.8000mm))
	(condition "A.NetName == '/SW'")
)
(rule "aiee_hv_145v_tank_RFOUT"
	(constraint clearance (min 0.8000mm))
	(condition "A.NetName == '/tank/RFOUT'")
)
(rule "aiee_hv_180v_tank_TANK_A"
	(constraint clearance (min 0.8000mm))
	(condition "A.NetName == '/tank/TANK_A'")
)
(rule "aiee_hv_203v_SW__tank_TANK_A"
	(constraint clearance (min 0.8000mm))
	(condition "A.NetName == '/SW' && B.NetName == '/tank/TANK_A'")
)
(rule "aiee_hv_151v_tank_TANK_A__tank_TANK_B"
	(constraint clearance (min 0.8000mm))
	(condition "A.NetName == '/tank/TANK_A' && B.NetName == '/tank/TANK_B'")
)
(rule "aiee_hv_135v_tank_TANK_B__tank_RFOUT"
	(constraint clearance (min 0.8000mm))
	(condition "A.NetName == '/tank/TANK_B' && B.NetName == '/tank/RFOUT'")
)

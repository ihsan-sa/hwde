	(text "ASSEMBLY AND SAFETY NOTES - BUILD REQUIREMENTS, NOT COMMENTARY"
		(exclude_from_sim no)
		(at 25.4 111.76 0.0000)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
		(justify left)
		)
		(uuid "1bc9a721-a956-434b-acd5-81857af3dbe5")
	)
	(text "1. R1's cold end reaches GND ONLY via the two soldered flange straps (footprint pad 2, x2)."
		(exclude_from_sim no)
		(at 25.4 119.38 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "76155d69-ded6-4e74-af38-76debdbdd0f8")
	)
	(text "   The bolted heatsink joint is NOT an electrical path: on an anodised finish it is 418 pF"
		(exclude_from_sim no)
		(at 25.4 123.825 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "6e9f03a1-7047-4949-8903-b6567b07a548")
	)
	(text "   = 15.2 ohm at 25 MHz. Solder both straps to the loose flange BEFORE bolting R1 down."
		(exclude_from_sim no)
		(at 25.4 128.27 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "9d0f21ee-e149-415a-9249-959f3251040d")
	)
	(text "2. The PCB rides on three 1.0 mm shims so that top copper (2.635 mm above the heatsink"
		(exclude_from_sim no)
		(at 25.4 135.255 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "0b25123e-2259-4d90-a5c0-27a3d244ec9c")
	)
	(text "   mounting plane) meets R1's tab underside (2.667 mm). Nominal solder gap 0.032 mm."
		(exclude_from_sim no)
		(at 25.4 139.7 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "b380a4fb-e857-448c-9a48-85231d1eb8d4")
	)
	(text "3. C1's threaded case is GND BY DESIGN - it is the metal a hand or a tuning tool touches."
		(exclude_from_sim no)
		(at 25.4 146.685 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "adc0bc4a-6e0d-42b2-b6f2-03e276206826")
	)
	(text "   Tune at reduced drive or with a VNA. NEVER tune at 150 W. Tool: Johanson 8764."
		(exclude_from_sim no)
		(at 25.4 151.13 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "96363b9d-c35e-4377-9610-996fbdc21a88")
	)
	(text "4. R1 is a +/-5% catalogue part. The 50 ohm +/-2% requirement is met by SELECT ON TEST at"
		(exclude_from_sim no)
		(at 25.4 158.115 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "9cae4b79-d39b-44bd-9765-9fca1b1e2076")
	)
	(text "   incoming inspection: measure each part, accept 49.00-51.00 ohm, reject outside."
		(exclude_from_sim no)
		(at 25.4 162.56 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "a215cad1-44fb-4ef6-b916-c2500940bf93")
	)
	(text "5. R1's substrate is BeO (beryllium oxide). DO NOT machine, drill, grind or break the part."
		(exclude_from_sim no)
		(at 25.4 169.545 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "61dbfb53-e935-4dd7-b29c-cc5a0bc96b04")
	)
	(text "   The dust is the hazard, not the intact part. Scrap it whole."
		(exclude_from_sim no)
		(at 25.4 173.99 0.0000)
		(effects
			(font
				(size 1.4 1.4)
			)
		(justify left)
		)
		(uuid "84d8a4e7-5f7e-4184-a949-354c8b601aa0")
	)

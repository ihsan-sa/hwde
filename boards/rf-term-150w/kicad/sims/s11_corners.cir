* ---- (B) Zin probes ---------------------------------------------------
.meas ac rin_nom find vr(zn) at=25e6
.meas ac xin_nom find vi(zn) at=25e6
.meas ac rin_wc find vr(zw) at=25e6
.meas ac xin_wc find vi(zw) at=25e6
.meas ac rin_cl find vr(zc) at=25e6
.meas ac xin_cl find vi(zc) at=25e6

* ---- (C) three-point two-sidedness -----------------------------------
.meas ac s_c_stop find vdb(gc1) at=25e6
.meas ac rl_c_stop param='-s_c_stop'
.meas ac s_c_null find vdb(gc2) at=25e6
.meas ac rl_c_null param='-s_c_null'
.meas ac s_c_up find vdb(gc3) at=25e6
.meas ac rl_c_up param='-s_c_up'
.meas ac d_c_down param='rl_c_null-rl_c_stop'
.meas ac d_c_up param='rl_c_null-rl_c_up'
.meas ac c_null_pf param='cnul*1e12'
.meas ac c_up_pf param='cup*1e12'
.meas ac s_n_stop find vdb(gn1) at=25e6
.meas ac rl_n_stop param='-s_n_stop'
.meas ac s_n_null find vdb(gn2) at=25e6
.meas ac rl_n_null param='-s_n_null'
.meas ac s_n_up find vdb(gn3) at=25e6
.meas ac rl_n_up param='-s_n_up'
.meas ac d_n_down param='rl_n_null-rl_n_stop'
.meas ac d_n_up param='rl_n_null-rl_n_up'
.meas ac n_null_pf param='cnun*1e12'
.meas ac n_up_pf param='cupn*1e12'

* ---- (D) compound worst corner ---------------------------------------
.meas ac s_d1 find vdb(gd1) at=25e6
.meas ac rl_cw_l185 param='-s_d1'
.meas ac s_d2 find vdb(gd2) at=25e6
.meas ac rl_cwid_l185 param='-s_d2'
.meas ac s_d3 find vdb(gd3) at=25e6
.meas ac rl_cw_l195 param='-s_d3'
.meas ac s_d4 find vdb(gd4) at=25e6
.meas ac rl_cwid_l195 param='-s_d4'
.meas ac s_d5 find vdb(gd5) at=25e6
.meas ac rl_cw_p65 param='-s_d5'
.meas ac s_d6 find vdb(gd6) at=25e6
.meas ac rl_pen_r50 param='-s_d6'
.meas ac s_d7 find vdb(gd7) at=25e6
.meas ac rl_penid_r50 param='-s_d7'
.meas ac pen_cw_l185 param='rl_cwid_l185-rl_cw_l185'
.meas ac pen_cw_l195 param='rl_cwid_l195-rl_cw_l195'
.meas ac pen_worst param='rl_penid_r50-rl_pen_r50'
.end

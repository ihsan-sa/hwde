	(text "SIGNAL CHAIN   J1 -> U1 (G1 = 39.90) -> U2B (G2 = 3.49) -> R6 -> J2"
		(exclude_from_sim no)
		(at 152.4 92.71 0.0000)
		(effects
			(font
